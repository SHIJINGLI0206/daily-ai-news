AI_RADAR_APP_NAME=AI Radar API
AI_RADAR_DB_PATH=./backend/data/ai_radar.sqlite3
AI_RADAR_SCHEDULE_ENABLED=true
AI_RADAR_INGESTION_ON_STARTUP=false
AI_RADAR_SCHEDULE_TIME=07:00
AI_RADAR_SCHEDULE_TIMEZONE=Pacific/Auckland
AI_RADAR_MAX_ITEMS_PER_SOURCE=12
AI_RADAR_REQUEST_TIMEOUT_SECONDS=20
AI_RADAR_ALLOWED_ORIGINS=http://localhost:3000

# Optional: protect POST /api/ingestion/run in a shared deployment.
# AI_RADAR_INGESTION_TOKEN=

# Optional comma-separated feed overrides. Format: id|name|url|category
# AI_RADAR_RSS_FEEDS=aws-ml|AWS Machine Learning|https://aws.amazon.com/blogs/machine-learning/feed/|Infrastructure
